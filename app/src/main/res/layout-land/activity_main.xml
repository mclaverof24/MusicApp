<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">

    <!-- SECCIÓN IZQUIERDA: PORTADA, TÍTULO, ARTISTA, BARRA DE PROGRESO -->
    <LinearLayout
        android:id="@+id/leftSection"
        android:layout_width="427dp"
        android:layout_height="420dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rightSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.5">

        <ImageView
            android:id="@+id/album"
            android:layout_width="wrap_content"
            android:layout_height="252dp"
            android:layout_weight="5"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/album" />

        <TextView
            android:id="@+id/songTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Finales de Agosto"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/artistName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Saiko"
            android:textColor="#AAAAAA"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="25"
            android:progressTint="#1DB954"
            android:thumbTint="#1DB954" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/timeElapsed"
                android:layout_width="117dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:45"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/timeRemaining"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="2:55"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- SECCIÓN DERECHA: BOTONES Y VOLUMEN -->
    <LinearLayout
        android:id="@+id/rightSection"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/leftSection"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:layout_constraintWidth_percent="0.5">

        <!-- LANDSCAPE: BOTONES DE CONTROL -->
        <LinearLayout
            android:id="@+id/playerControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="35dp"
                app:cardElevation="12dp">

                <ImageButton
                    android:id="@+id/prevButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:padding="16dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_prev"
                    app:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="45dp"
                app:cardElevation="12dp">

                <ImageButton
                    android:id="@+id/playPauseButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:padding="20dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_play"
                    app:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="35dp"
                app:cardElevation="12dp">

                <ImageButton
                    android:id="@+id/nextButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:padding="16dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_next"
                    app:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>


        <!-- VOLUMEN: BOTÓN + SEEKBAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="10dp">

                <ImageButton
                    android:id="@+id/volumeButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_volume"
                    app:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>

            <SeekBar
                android:id="@+id/volumeBar"
                android:layout_width="0dp"
                android:layout_height="15dp"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:backgroundTint="#555555"
                android:max="100"
                android:progress="70"
                android:progressTint="#1DB954"
                android:splitTrack="false"
                android:thumbTint="#1DB954" />
        </LinearLayout>

        <!-- BOTONES EXTRA -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="10dp">

                <ImageButton
                    android:id="@+id/shareButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    app:srcCompat="@drawable/ic_share"
                    app:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="10dp">

                <ImageButton
                    android:id="@+id/lyricsButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    app:srcCompat="@drawable/ic_lyrics"
                    app:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="10dp">

                <ImageButton
                    android:id="@+id/queueButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    app:srcCompat="@drawable/ic_queue"
                    app:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
